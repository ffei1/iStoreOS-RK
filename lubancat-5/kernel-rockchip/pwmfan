#!/bin/sh /etc/rc.common
# PWM初始化脚本

START=99
STOP=10

start() {
    echo "Exporting PWM channel 0"
    echo 0 > /sys/class/pwm/pwmchip0/export
	
    # 等待PWM通道就绪
    sleep 1
	
    # 配置PWM参数（根据你的需求调整）
    echo 50000 > /sys/class/pwm/pwmchip0/pwm0/period
    echo 49800 > /sys/class/pwm/pwmchip0/pwm0/duty_cycle      # 20ms周期
    echo 1 > /sys/class/pwm/pwmchip0/pwm0/enable   # 1.5ms占空比
    
    echo "PWM configuration completed"
}

stop() {
    echo "Disabling PWM output"
    echo 0 > /sys/class/pwm/pwmchip0/pwm0/enable
    echo 0 > /sys/class/pwm/pwmchip0/unexport
}